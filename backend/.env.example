PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Supabase Credentials (Render & Local Database/Auth)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Secret for Session & Tokens
JWT_SECRET=pharmavision_super_secret_jwt_key_2026

# Google Gemini API Key (Supports single key OR comma-separated keys for auto-failover: key1,key2,key3)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini Model Override (Auto-prioritizes: gemini-3.7-flash -> gemini-3.6-flash -> gemini-3.5-flash -> gemini-2.5-flash)
GEMINI_MODEL=gemini-3.7-flash

# OpenAI API Key (Optional failover for GPT-4o / GPT-4o-mini vision and chat)
OPENAI_API_KEY=your_openai_api_key_here

# NIH / NCBI Entrez API Key (Optional: increases PubChem / MeSH rate limit to 10 req/sec)
NCBI_API_KEY=your_ncbi_api_key_here

# MongoDB Fallback (Optional)
MONGODB_URI=mongodb://localhost:27017/pharmavision
